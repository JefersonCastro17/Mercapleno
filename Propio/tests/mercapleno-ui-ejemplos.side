{
  "id": "mercapleno-ui-ejemplos",
  "version": "2.0",
  "name": "Mercapleno UI ejemplos",
  "url": "http://localhost:5173",
  "tests": [
    {
      "name": "Login exitoso lleva al catálogo",
      "commands": [
        { "command": "open", "target": "/login", "value": "" },
        { "command": "type", "target": "id=email", "value": "cliente@ejemplo.com" },
        { "command": "type", "target": "id=password", "value": "Password123" },
        { "command": "click", "target": "css=button[type='submit']", "value": "" },
        { "command": "waitForPageToLoad", "target": "5000", "value": "" },
        { "command": "assertLocation", "target": "http://localhost:5173/catalogo", "value": "" }
      ]
    },
    {
      "name": "Login con credenciales invalidas muestra error",
      "commands": [
        { "command": "open", "target": "/login", "value": "" },
        { "command": "type", "target": "id=email", "value": "usuario@invalido.com" },
        { "command": "type", "target": "id=password", "value": "passincorrecta" },
        { "command": "click", "target": "css=button[type='submit']", "value": "" },
        { "command": "waitForAlert", "target": "4000", "value": "" },
        { "command": "assertAlertText", "target": "Credenciales incorrectas|Error de conexion con el servidor de autenticacion.", "value": "" }
      ]
    },
    {
      "name": "Registro requiere todos los campos",
      "commands": [
        { "command": "open", "target": "/registro", "value": "" },
        { "command": "type", "target": "id=nombre", "value": "Ana" },
        { "command": "type", "target": "id=apellido", "value": "García" },
        { "command": "type", "target": "id=email", "value": "ana@ejemplo.com" },
        { "command": "type", "target": "id=password", "value": "Password123" },
        { "command": "type", "target": "id=direccion", "value": "Calle 12 #34" },
        { "command": "type", "target": "id=fecha_nacimiento", "value": "2010-05-12" },
        { "command": "select", "target": "id=id_tipo_identificacion", "value": "1" },
        { "command": "type", "target": "id=numero_identificacion", "value": "123456789" },
        { "command": "click", "target": "css=button[type='submit']", "value": "" },
        { "command": "assertText", "target": "css=.message.error", "value": "Por favor completa todos los campos" }
      ]
    },
    {
      "name": "Acceso al catálogo desde la navegación principal",
      "commands": [
        { "command": "open", "target": "/login", "value": "" },
        { "command": "click", "target": "linkText=Inicio", "value": "" },
        { "command": "click", "target": "linkText=Registrate", "value": "" },
        { "command": "assertLocation", "target": "http://localhost:5173/registro", "value": "" },
        { "command": "click", "target": "linkText=Iniciar Sesion", "value": "" },
        { "command": "assertLocation", "target": "http://localhost:5173/login", "value": "" }
      ]
    }
  ],
  "suites": [
    {
      "id": "default-suite",
      "name": "Default Suite",
      "persistSession": false,
      "parallel": false,
      "timeout": 30000,
      "tests": [
        "Login exitoso lleva al catálogo",
        "Login con credenciales invalidas muestra error",
        "Registro requiere todos los campos",
        "Acceso al catálogo desde la navegación principal"
      ]
    }
  ],
  "urls": [
    "http://localhost:5173"
  ]
}
