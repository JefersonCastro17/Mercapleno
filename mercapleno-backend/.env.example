# App Configuration
PORT=4000
APP_NAME=Mercapleno
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/mercapleno?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=mercapleno

# JWT Authentication
JWT_SECRET=yogui
JWT_EXPIRES_IN=2h
ADMIN_ROLE_ID=1

# Email / SMTP Settings
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mercapleno@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM_EMAIL=mercapleno@gmail.com

# Verification & Recovery TTLs (Minutes)
EMAIL_VERIFICATION_TTL_MIN=15
LOGIN_2FA_TTL_MIN=10
PASSWORD_RESET_TTL_MIN=15

# Security & Business limits
INTERNAL_API_KEY=mercapleno123456789
LOW_STOCK_THRESHOLD=5
