# App Configuration
PORT=4000
APP_NAME=Mercapleno
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Connection (Used by Prisma and direct MySQL connections)
DATABASE_URL=mysql://db_user:db_password@db_host:db_port/db_name
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root_password
DB_NAME=mercapleno

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=2h
ADMIN_ROLE_ID=1

# Email / SMTP Settings
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# Verification & Recovery TTLs (Minutes)
EMAIL_VERIFICATION_TTL_MIN=15
PASSWORD_RESET_TTL_MIN=15

# Security & Business limits
INTERNAL_API_KEY=your_internal_api_key_here
LOW_STOCK_THRESHOLD=5
