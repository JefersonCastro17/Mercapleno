{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "tester",
    "scripts",
    "prisma",
    "reports",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
