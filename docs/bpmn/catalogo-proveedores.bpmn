<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_CatManual"
                  targetNamespace="http://mercapleno.com/bpmn/catalogo-manual">
  <bpmn:collaboration id="Collaboration_CatManual">
    <bpmn:participant id="Participant_CatManual" name="Proceso de Gestión Manual de Proveedores y Catálogo de Productos (Problemática) - Mercapleno" processRef="Process_CatManual" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CatManual" isExecutable="false">
    <bpmn:laneSet id="LaneSet_CatManual">
      <bpmn:lane id="Lane_Admin_C" name="Administrador del Supermercado">
        <bpmn:flowNodeRef>Start_Cat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AtenderProv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negociar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rotular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProdNuevo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuscarCarpeta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckDeudas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BloquearManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Bloqueo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarcarInactivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProvRetirado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Arch" name="Archivador Físico de Oficina">
        <bpmn:flowNodeRef>Task_AnotarLibreta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes -->
    <bpmn:startEvent id="Start_Cat" name="Necesidad de registrar producto o gestionar proveedor">
      <bpmn:outgoing>Flow_K1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_Tipo" name="¿Qué gestión manual se requiere?">
      <bpmn:incoming>Flow_K1</bpmn:incoming>
      <bpmn:outgoing>Flow_TipoProd</bpmn:outgoing>
      <bpmn:outgoing>Flow_TipoProv</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rama Producto Nuevo -->
    <bpmn:userTask id="Task_AtenderProv" name="Recibir al proveedor en oficina y revisar catálogo impreso">
      <bpmn:incoming>Flow_TipoProd</bpmn:incoming>
      <bpmn:outgoing>Flow_KP2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Negociar" name="Pactar precio de compra y calcular precio de venta en papel">
      <bpmn:incoming>Flow_KP2</bpmn:incoming>
      <bpmn:outgoing>Flow_KP3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AnotarLibreta" name="Escribir nombre, costo y precio en libreta maestra de papel">
      <bpmn:incoming>Flow_KP3</bpmn:incoming>
      <bpmn:outgoing>Flow_KP4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Rotular" name="Elaborar etiquetas adhesivas de precio a mano y pegarlas">
      <bpmn:incoming>Flow_KP4</bpmn:incoming>
      <bpmn:outgoing>Flow_KP5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_ProdNuevo" name="Producto exhibido físicamente con precio manual">
      <bpmn:incoming>Flow_KP5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Rama Retiro / Descontinuar Proveedor -->
    <bpmn:userTask id="Task_BuscarCarpeta" name="Buscar manualmente la carpeta del proveedor en archivador">
      <bpmn:incoming>Flow_TipoProv</bpmn:incoming>
      <bpmn:outgoing>Flow_KV2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CheckDeudas" name="¿Tiene facturas a crédito pendientes o mercancía en consignación?">
      <bpmn:incoming>Flow_KV2</bpmn:incoming>
      <bpmn:outgoing>Flow_DeudasSi</bpmn:outgoing>
      <bpmn:outgoing>Flow_DeudasNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_BloquearManual" name="Revisar recibos de pago para cuadrar cuentas antes de suspender">
      <bpmn:incoming>Flow_DeudasSi</bpmn:incoming>
      <bpmn:outgoing>Flow_KV3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Bloqueo" name="Retiro suspendido hasta conciliar facturas de papel">
      <bpmn:incoming>Flow_KV3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_MarcarInactivo" name="Anotar 'Inactivo' en la carpeta física y no volver a llamarlo">
      <bpmn:incoming>Flow_DeudasNo</bpmn:incoming>
      <bpmn:outgoing>Flow_KV4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_ProvRetirado" name="Proveedor archivado en carpeta de inactivos">
      <bpmn:incoming>Flow_KV4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_K1" sourceRef="Start_Cat" targetRef="Gateway_Tipo" />
    <bpmn:sequenceFlow id="Flow_TipoProd" name="Nuevo Producto" sourceRef="Gateway_Tipo" targetRef="Task_AtenderProv" />
    <bpmn:sequenceFlow id="Flow_TipoProv" name="Retirar Proveedor" sourceRef="Gateway_Tipo" targetRef="Task_BuscarCarpeta" />

    <bpmn:sequenceFlow id="Flow_KP2" sourceRef="Task_AtenderProv" targetRef="Task_Negociar" />
    <bpmn:sequenceFlow id="Flow_KP3" sourceRef="Task_Negociar" targetRef="Task_AnotarLibreta" />
    <bpmn:sequenceFlow id="Flow_KP4" sourceRef="Task_AnotarLibreta" targetRef="Task_Rotular" />
    <bpmn:sequenceFlow id="Flow_KP5" sourceRef="Task_Rotular" targetRef="End_ProdNuevo" />

    <bpmn:sequenceFlow id="Flow_KV2" sourceRef="Task_BuscarCarpeta" targetRef="Gateway_CheckDeudas" />
    <bpmn:sequenceFlow id="Flow_DeudasSi" name="Sí (Tiene pendientes)" sourceRef="Gateway_CheckDeudas" targetRef="Task_BloquearManual" />
    <bpmn:sequenceFlow id="Flow_KV3" sourceRef="Task_BloquearManual" targetRef="End_Bloqueo" />
    <bpmn:sequenceFlow id="Flow_DeudasNo" name="No (Al día)" sourceRef="Gateway_CheckDeudas" targetRef="Task_MarcarInactivo" />
    <bpmn:sequenceFlow id="Flow_KV4" sourceRef="Task_MarcarInactivo" targetRef="End_ProvRetirado" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_CatManual">
    <bpmndi:BPMNPlane id="BPMNPlane_CatManual" bpmnElement="Collaboration_CatManual">
      <!-- Pool -->
      <bpmndi:BPMNShape id="Participant_CatManual_di" bpmnElement="Participant_CatManual" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1440" height="540" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_Admin_C_di" bpmnElement="Lane_Admin_C" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1410" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Arch_di" bpmnElement="Lane_Arch" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="1410" height="200" />
      </bpmndi:BPMNShape>

      <!-- Lane Admin Elements -->
      <bpmndi:BPMNShape id="Start_Cat_di" bpmnElement="Start_Cat">
        <dc:Bounds x="222" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="206" y="185" width="70" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Tipo_di" bpmnElement="Gateway_Tipo" isMarkerVisible="true">
        <dc:Bounds x="315" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="296" y="95" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AtenderProv_di" bpmnElement="Task_AtenderProv">
        <dc:Bounds x="420" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Negociar_di" bpmnElement="Task_Negociar">
        <dc:Bounds x="590" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rotular_di" bpmnElement="Task_Rotular">
        <dc:Bounds x="760" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ProdNuevo_di" bpmnElement="End_ProdNuevo">
        <dc:Bounds x="942" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="918" y="175" width="85" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_BuscarCarpeta_di" bpmnElement="Task_BuscarCarpeta">
        <dc:Bounds x="420" y="240" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckDeudas_di" bpmnElement="Gateway_CheckDeudas" isMarkerVisible="true">
        <dc:Bounds x="595" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="200" width="84" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BloquearManual_di" bpmnElement="Task_BloquearManual">
        <dc:Bounds x="700" y="240" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Bloqueo_di" bpmnElement="End_Bloqueo">
        <dc:Bounds x="872" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="848" y="305" width="85" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarcarInactivo_di" bpmnElement="Task_MarcarInactivo">
        <dc:Bounds x="555" y="340" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ProvRetirado_di" bpmnElement="End_ProvRetirado">
        <dc:Bounds x="742" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="718" y="395" width="85" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Lane Archivador Elements -->
      <bpmndi:BPMNShape id="Task_AnotarLibreta_di" bpmnElement="Task_AnotarLibreta">
        <dc:Bounds x="675" y="460" width="130" height="80" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_K1_di" bpmnElement="Flow_K1">
        <di:waypoint x="258" y="160" />
        <di:waypoint x="315" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TipoProd_di" bpmnElement="Flow_TipoProd">
        <di:waypoint x="365" y="160" />
        <di:waypoint x="420" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="355" y="142" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TipoProv_di" bpmnElement="Flow_TipoProv">
        <di:waypoint x="340" y="185" />
        <di:waypoint x="340" y="280" />
        <di:waypoint x="420" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="348" y="235" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_KP2_di" bpmnElement="Flow_KP2">
        <di:waypoint x="550" y="150" />
        <di:waypoint x="590" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_KP3_di" bpmnElement="Flow_KP3">
        <di:waypoint x="655" y="190" />
        <di:waypoint x="655" y="500" />
        <di:waypoint x="675" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_KP4_di" bpmnElement="Flow_KP4">
        <di:waypoint x="805" y="500" />
        <di:waypoint x="825" y="500" />
        <di:waypoint x="825" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_KP5_di" bpmnElement="Flow_KP5">
        <di:waypoint x="890" y="150" />
        <di:waypoint x="942" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_KV2_di" bpmnElement="Flow_KV2">
        <di:waypoint x="550" y="280" />
        <di:waypoint x="595" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeudasSi_di" bpmnElement="Flow_DeudasSi">
        <di:waypoint x="645" y="280" />
        <di:waypoint x="700" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="262" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_KV3_di" bpmnElement="Flow_KV3">
        <di:waypoint x="830" y="280" />
        <di:waypoint x="872" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeudasNo_di" bpmnElement="Flow_DeudasNo">
        <di:waypoint x="620" y="305" />
        <di:waypoint x="620" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="310" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_KV4_di" bpmnElement="Flow_KV4">
        <di:waypoint x="685" y="370" />
        <di:waypoint x="742" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
